# Backend
APP_ID=                   # Optional: Kimi OAuth application ID
APP_SECRET=               # Optional for Kimi, also accepted as local JWT secret
LOCAL_AUTH_SECRET=        # Required in production for password and Google-login JWTs

# Database
DATABASE_URL=             # PostgreSQL connection string

# Public site URL
PUBLIC_SITE_URL=          # Production origin, e.g. https://your-domain.com

# Google OAuth
GOOGLE_CLIENT_ID=         # Google OAuth client ID
GOOGLE_CLIENT_SECRET=     # Google OAuth client secret
GOOGLE_OAUTH_SCOPES=openid email profile

# Kimi OAuth
KIMI_AUTH_URL=            # Optional: defaults to https://auth.kimi.com
KIMI_OPEN_URL=            # Optional: defaults to https://open.kimi.com
VITE_KIMI_AUTH_URL=       # Optional browser-facing Kimi OAuth URL
VITE_APP_ID=              # Optional browser-facing Kimi OAuth application ID

# Admin role
OWNER_UNION_ID=           # Kimi union ID of the app creator
